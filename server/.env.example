# Скопіюй цей файл у .env і заповни реальними значеннями. Ніколи не комітьте .env!

# Рядок підключення до PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/planmoney

# Довгий випадковий рядок для підпису JWT-токенів (згенеруй свій, напр. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret

# Домен фронтенду, з якого дозволені запити (кілька — через кому)
CORS_ORIGIN=http://localhost:5173

# Порт сервера (хостинг зазвичай підставляє свій — тоді ця змінна ігнорується)
PORT=3000
