// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Таблиця користувачів
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())

  transactions Transaction[]
  tasks        Task[]
  categories   Category[]
  goals        Goal[]
  setting      Setting?
  accounts     Account[]
}

// Таблиця рахунків користувача
model Account {
  id        Int      @id @default(autoincrement())
  name      String
  currency  String   @default("UAH")
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  transactions      Transaction[] @relation("AccountTransactions")
  incomingTransfers Transaction[] @relation("ToAccountTransactions")
}

// Таблиця транзакцій (доходи, витрати, перекази)
model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Int
  type      String
  category  String
  note      String?
  status    String   @default("completed")
  date      DateTime @default(now())

  accountId   Int?
  account     Account? @relation("AccountTransactions", fields: [accountId], references: [id])
  toAccountId Int?
  toAccount   Account? @relation("ToAccountTransactions", fields: [toAccountId], references: [id])
  // Сума, зарахована на рахунок-отримувач, у ЙОГО валюті. Для переказів між
  // рахунками різних валют рахується за курсом НБУ на момент операції.
  toAmount    Int?

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

// Таблиця задач
model Task {
  id        Int       @id @default(autoincrement())
  title     String
  note      String?
  category  String?
  priority  String    @default("medium")
  status    String    @default("todo")
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])
}

// Таблиця категорій
model Category {
  id     Int     @id @default(autoincrement())
  name   String
  type   String
  color  String?

  userId Int
  user   User    @relation(fields: [userId], references: [id])
}

// Таблиця цілей накопичення
model Goal {
  id           Int      @id @default(autoincrement())
  title        String
  targetAmount Int
  savedAmount  Int      @default(0)
  createdAt    DateTime @default(now())

  userId       Int
  user         User     @relation(fields: [userId], references: [id])
}

// Таблиця налаштувань користувача
model Setting {
  id            Int      @id @default(autoincrement())

  // Сповіщення
  notifyTasks   Boolean  @default(true)
  notifyBudget  Boolean  @default(true)
  notifyGoals   Boolean  @default(true)
  emailDigest   Boolean  @default(false)

  // Вигляд
  theme         String   @default("light")
  accentColor   String   @default("orange")

  // Фінансові налаштування
  currency      String   @default("UAH")
  monthStart    Int      @default(1)
  rounding      String   @default("none")
  language      String   @default("uk")

  // Бюджет
  monthlyBudget Int?

  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
}
