// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Таблиця користувачів
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())

  transactions Transaction[]
  tasks        Task[]
  categories   Category[]
  goals        Goal[]
}

// Таблиця транзакцій (доходи та витрати)
model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Int
  type      String
  category  String
  note      String?
  date      DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

// Таблиця задач
model Task {
  id        Int       @id @default(autoincrement())
  title     String
  note      String?
  category  String?
  priority  String    @default("medium")
  status    String    @default("todo")
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])
}

// Таблиця категорій
model Category {
  id     Int     @id @default(autoincrement())
  name   String
  type   String
  color  String?

  userId Int
  user   User    @relation(fields: [userId], references: [id])
}

// Таблиця цілей накопичення
model Goal {
  id           Int      @id @default(autoincrement())
  title        String
  targetAmount Int
  savedAmount  Int      @default(0)
  createdAt    DateTime @default(now())

  userId       Int
  user         User     @relation(fields: [userId], references: [id])
}
